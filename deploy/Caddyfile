# HTTPS for the relay. Caddy gets a certificate for $YACS_DOMAIN by itself.
#
# No access log on purpose: request paths contain channel ids. The relay
# logs only route patterns.
{$YACS_DOMAIN} {
	# Not the live event streams: compressing them could hold events back.
	@compressible not path */events
	encode @compressible zstd gzip
	reverse_proxy yacs:8080
}
