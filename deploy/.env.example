# Domain pointing at this machine, e.g. clip.example.com (compose.yaml, with Caddy)
YACS_DOMAIN=

# The relay's account key: creating a space needs it, joining one doesn't.
# Without it anyone who finds the relay can fill its disk.
# Generate one with:  openssl rand -base64 32
YACS_ACCESS_TOKEN=

# Optional, defaults shown.
# YACS_VERSION=latest    # image tag, e.g. 0.1.0 to pin a release
# YACS_PORT=8080         # localhost port for nginx (compose.nginx.yaml)
# YACS_DEFAULT_TTL=15m
# YACS_MAX_TTL=24h
# YACS_MAX_SIZE=20MB
# YACS_MAX_DISK=25GB    # all channels together; big files count from the start of their upload

# A public relay: anyone may create spaces, on the free plan below. Spaces made
# with YACS_ACCESS_TOKEN keep the limits above. Keep YACS_MAX_DISK small enough
# for the machine; the proxy must set X-Forwarded-For (both setups here do).
# YACS_PUBLIC=true
# YACS_FREE_MAX_SIZE=10MB          # per clip, chunks included
# YACS_FREE_MAX_TTL=1h
# YACS_FREE_DAILY_TRANSFER=500MB   # per space, uploads and downloads
# YACS_NEW_SPACES_PER_IP=10        # per day
# YACS_REQUESTS_PER_MINUTE=600     # per IP address
# YACS_PRIVACY_URL=https://…       # your privacy policy; the apps link it
# YACS_IMPRINT_URL=https://…       # your imprint (Impressum)
