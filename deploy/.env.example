# Domain pointing at this machine, e.g. clip.example.com
YACS_DOMAIN=

# Clients must send this; without it anyone who finds the relay can fill its disk.
# Generate one with:  openssl rand -base64 32
YACS_ACCESS_TOKEN=

# Optional, defaults shown.
# YACS_DEFAULT_TTL=15m
# YACS_MAX_TTL=24h
# YACS_MAX_SIZE=20MB
# YACS_MAX_DISK=2GB
