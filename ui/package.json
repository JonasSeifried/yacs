{
  "name": "@yacs/ui",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "wasm": "wasm-pack build ../crates/yacs-wasm --target web --release --out-dir ../../ui/src/wasm --out-name yacs --no-pack",
    "build": "tsc --noEmit && vite build --mode desktop && vite build --mode web",
    "build:desktop": "vite build --mode desktop",
    "build:web": "vite build --mode web",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "dompurify": "^3.4.16",
    "jsqr": "1.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
