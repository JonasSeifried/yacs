{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YACS",
  "version": "0.2.3",
  "identifier": "com.jonasseifried.yacs",
  "build": {
    "beforeDevCommand": "pnpm --filter @yacs/ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @yacs/ui build:desktop",
    "frontendDist": "../../../ui/dist/desktop"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:",
      "devCsp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "license": "AGPL-3.0-only",
    "licenseFile": "../../../LICENSE",
    "shortDescription": "End-to-end encrypted clipboard sync",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGRDkwMjQ3NzY2NTM0QTIKUldTaU5HVjJSd0xaVHhEMk5zeVhoUzdjT2tyZUlGQ1dOMmJwbXJhMnNQUlE0K2VoNzA5YXJHZXAK",
      "endpoints": [
        "https://github.com/JonasSeifried/yacs/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
