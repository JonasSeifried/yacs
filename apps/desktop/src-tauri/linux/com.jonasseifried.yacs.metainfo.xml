<component type="desktop-application">
  <id>com.jonasseifried.yacs</id>
  <name>YACS</name>
  <summary>End-to-end encrypted clipboard sync</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-only</project_license>
  <developer id="com.jonasseifried">
    <name>Jonas Seifried</name>
  </developer>
  <description>
    <p>
      Yet Another Clipboard Service: copy on one device, paste on another.
      End-to-end encrypted, self-hosted, no accounts.
    </p>
    <p>
      A shortcut opens a Spotlight-style panel that sends your clipboard or
      copies a clip back, with every format it had (text, HTML, RTF, images).
      Clips go through a relay you host, which stores them encrypted until
      they expire and can't read them.
    </p>
  </description>
